# TimeEase production URL
NEXT_PUBLIC_SITE_URL=https://timeease-ruby.vercel.app

# Stripe live credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe recurring monthly Price IDs
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=

# Production release: proposals only; keep false/unset in every current deployment.
# Exact SHA must match the approved deployment's VERCEL_GIT_COMMIT_SHA.
TIMEEASE_RELEASE_COMMIT_SHA=
TIMEEASE_V2_OUTBOX_ENABLED=false
TIMEEASE_RELEASE_ACCEPTING_WORK=false
TIMEEASE_RELEASE_SEND_ENABLED=false
# Provision distinct limited-role secrets separately; never copy Preview secrets.
TIMEEASE_WORKER_DATABASE_URL=
# TIMEEASE_DB_DATABASE_URL must use timeease_payment_limited for Production.
